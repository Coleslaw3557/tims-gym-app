[Unit]
Description=Gym Tracker App
After=network.target

[Service]
Type=simple
User=tlister
WorkingDirectory=/home/tlister/Documents/gym-app/app
Environment="PATH=/home/tlister/Documents/gym-app/venv/bin"
ExecStart=/home/tlister/Documents/gym-app/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
